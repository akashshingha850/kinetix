.DS_Store
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# data/<run>/ (flight + reconstruction's <method>/ subdirs, e.g. sfm/): the small text files are in git, the large ones below are
# not; data/sync.sh puts/gets them as one zip per run on the GitHub release `data` (data/.dropped: runs this machine skips)
data/*/frames/
data/*/depth/
data/*/*/database.db
data/*/*/sparse/
data/*/*/tri/
data/*/*/*.ply
data/.dropped
.env
# flight recordings (MavrosRig rig.bag, ADR-K11): never in git, synced with the run's zip
rosbag/
*.mcap

# graphify: graph.json, report, manifest and labels may be tracked; derived or machine-specific files are not
graphify-out/graph.html
graphify-out/cache/
graphify-out/.graphify_root
graphify-out/.graphify_python
